generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Division {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(50)
  teams Team[]
}

model Team {
  id                     Int     @id @default(autoincrement())
  name                   String  @db.VarChar(100)
  division_id            Int?
  is_user_team           Boolean @default(false)
  budget                 Decimal @default(0) @db.Decimal(14, 2)
  reputation             Int     @default(50)
  wins                   Int     @default(0)
  losses                 Int     @default(0)
  runs_scored            Int     @default(0)
  runs_allowed           Int     @default(0)
  bid_aggressiveness     Float   @default(0.10)
  player_investment_rate Float   @default(0.1)
  desperation_index      Float   @default(0)
  min_growth_threshold   Float   @default(1.5)
  fan_base               Int     @default(0)
  stadium_floors         Int     @default(1)
  alerts_seen_at         DateTime?

  division              Division?            @relation(fields: [division_id], references: [id])
  players               Player[]
  finances              Finance[]
  scouts                Scout[]
  coaches               Coach[]
  stadium_sections      StadiumSection[]
  home_games            GameSchedule[]       @relation("HomeTeam")
  away_games            GameSchedule[]       @relation("AwayTeam")
  game_lineups          GameLineup[]
  team_lineups          TeamLineup[]
  batting_events        GameEvent[]          @relation("BattingTeam")
  won_auctions          FreeAgentAuction[]   @relation("AuctionWinner")
  auction_bids          AuctionBid[]
  broadcast_offers      BroadcastOffer[]
  broadcast_contracts   BroadcastContract[]
  playoff_home          PlayoffSeries[]      @relation("PlayoffHome")
  playoff_away          PlayoffSeries[]      @relation("PlayoffAway")
  playoff_won           PlayoffSeries[]      @relation("PlayoffWinner")
  trades_proposed       Trade[]              @relation("TradeProposer")
  trades_received       Trade[]              @relation("TradeRecipient")
  derby_entries         DerbyEntry[]
  luxury_tax_records    LuxuryTaxRecord[]
  season_awards         SeasonAward[]
  player_season_records PlayerSeasonRecord[]
  toddler_contributions ToddlerContribution[]
}

model Player {
  id                       Int       @id @default(autoincrement())
  first_name               String    @db.VarChar(50)
  last_name                String    @db.VarChar(50)
  age                      Int
  position                 String    @db.VarChar(10)
  potential_coefficient    Int
  growth_age               Int
  current_skill            Int
  salary                   Decimal   @db.Decimal(12, 2)
  contract_years_remaining Int       @default(1)
  rookie_contract          Boolean   @default(false)
  rookie_seasons           Int       @default(0)
  team_id                  Int?
  status                   String    @default("active") @db.VarChar(20)
  injury_days_remaining    Int       @default(0)
  level                    String    @default("MAJOR") @db.VarChar(10)
  toddler_program_id       Int?
  career_home_runs         Int       @default(0)
  career_hits              Int       @default(0)
  career_rbi               Int       @default(0)
  career_wins              Int       @default(0)
  career_strikeouts        Int       @default(0)
  career_innings_pitched   Decimal   @default(0) @db.Decimal(8, 1)
  career_earned_runs       Int       @default(0)
  career_stats_updated_at  DateTime?

  team                   Team?                @relation(fields: [team_id], references: [id])
  coach                  Coach?
  auctions               FreeAgentAuction[]
  game_lineups           GameLineup[]
  team_lineups           TeamLineup[]
  game_events            GameEvent[]          @relation("PlayerEvent")
  trade_items            TradeItem[]
  derby_entries          DerbyEntry[]
  draft_prospect_sources DraftProspect[]
  season_awards          SeasonAward[]
  player_season_records  PlayerSeasonRecord[]

  @@index([team_id])
  @@index([status])
  @@index([team_id, level])
  @@index([toddler_program_id])
}

model Season {
  id          Int    @id @default(autoincrement())
  year        Int
  current_day Int    @default(1)
  total_days  Int    @default(0)
  status      String @default("active") @db.VarChar(20)

  schedule              GameSchedule[]
  auctions              FreeAgentAuction[]
  broadcast_offers      BroadcastOffer[]
  broadcast_contracts   BroadcastContract[]
  playoff_series        PlayoffSeries[]
  draft                 Draft?
  season_record         SeasonRecord?
  trades                Trade[]
  derby_events          HomeRunDerbyEvent[]
  luxury_tax_records    LuxuryTaxRecord[]
  season_awards         SeasonAward[]
  player_season_records PlayerSeasonRecord[]
}

model SeasonRecord {
  id            Int     @id @default(autoincrement())
  season_id     Int     @unique
  year          Int
  champion_name String? @db.VarChar(100)
  standings     Json

  season Season @relation(fields: [season_id], references: [id])

  @@map("season_records")
}

model GameSchedule {
  id                Int     @id @default(autoincrement())
  season_id         Int?
  day_number        Int
  home_team_id      Int?
  away_team_id      Int?
  home_score        Int?
  away_score        Int?
  status            String  @default("scheduled") @db.VarChar(20)
  is_user_game      Boolean @default(false)
  playoff_series_id Int?

  season         Season?        @relation(fields: [season_id], references: [id])
  home_team      Team?          @relation("HomeTeam", fields: [home_team_id], references: [id])
  away_team      Team?          @relation("AwayTeam", fields: [away_team_id], references: [id])
  playoff_series PlayoffSeries? @relation(fields: [playoff_series_id], references: [id])
  game_lineups   GameLineup[]
  game_events    GameEvent[]

  @@index([season_id, day_number])
  @@map("schedule")
}

model PlayoffSeries {
  id           Int    @id @default(autoincrement())
  season_id    Int
  round        Int
  series_order Int
  home_team_id Int
  away_team_id Int
  home_wins    Int    @default(0)
  away_wins    Int    @default(0)
  wins_needed  Int    @default(2)
  status       String @default("active")
  winner_id    Int?

  season    Season         @relation(fields: [season_id], references: [id])
  home_team Team           @relation("PlayoffHome", fields: [home_team_id], references: [id])
  away_team Team           @relation("PlayoffAway", fields: [away_team_id], references: [id])
  winner    Team?          @relation("PlayoffWinner", fields: [winner_id], references: [id])
  games     GameSchedule[]

  @@map("playoff_series")
}

model StadiumSection {
  id               Int     @id @default(autoincrement())
  team_id          Int?
  row_pos          Int
  col_pos          Int
  section_type     String  @db.VarChar(20)
  label            String? @db.VarChar(50)
  price_per_ticket Decimal @default(0) @db.Decimal(8, 2)
  upgrade_level    Int     @default(0)
  capacity         Int     @default(0)

  team Team? @relation(fields: [team_id], references: [id])

  @@index([team_id])
  @@map("stadium_sections")
}

model Finance {
  id          Int      @id @default(autoincrement())
  team_id     Int?
  season_day  Int?
  type        String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  created_at  DateTime @default(now())

  team Team? @relation(fields: [team_id], references: [id])

  @@index([team_id])
  @@map("finances")
}

model LuxuryTaxRecord {
  id                           Int      @id @default(autoincrement())
  season_id                    Int
  team_id                      Int
  day                          Int
  charged                      Boolean  @default(false)
  payroll                      Decimal  @db.Decimal(14, 2)
  threshold                    Decimal  @db.Decimal(14, 2)
  league_median_cost_per_skill Decimal  @db.Decimal(14, 4)
  cost_per_skill               Decimal  @db.Decimal(14, 4)
  ratio                        Float
  extra_points                 Float
  bracket_tax                  Decimal  @db.Decimal(14, 2)
  inefficiency_tax             Decimal  @db.Decimal(14, 2)
  total_tax                    Decimal  @db.Decimal(14, 2)
  created_at                   DateTime @default(now())

  season Season @relation(fields: [season_id], references: [id])
  team   Team   @relation(fields: [team_id], references: [id])

  @@index([season_id, team_id])
  @@index([team_id])
  @@map("luxury_tax_records")
}

model Scout {
  id              Int     @id @default(autoincrement())
  team_id         Int?
  name            String? @db.VarChar(100)
  skill_level     Int     @default(50)
  budget_assigned Decimal @default(0) @db.Decimal(10, 2)
  active_mission  Boolean @default(false)
  mission_end_day Int?
  target_position String? @db.VarChar(10)

  team Team? @relation(fields: [team_id], references: [id])

  @@map("scouts")
}

model GameLineup {
  id            Int     @id @default(autoincrement())
  game_id       Int?
  team_id       Int?
  player_id     Int?
  batting_order Int?
  position      String? @db.VarChar(10)

  game   GameSchedule? @relation(fields: [game_id], references: [id])
  team   Team?         @relation(fields: [team_id], references: [id])
  player Player?       @relation(fields: [player_id], references: [id])

  @@index([player_id])
  @@map("game_lineups")
}

model GameEvent {
  id              Int     @id @default(autoincrement())
  game_id         Int?
  inning          Int?
  half            String? @db.VarChar(4)
  batting_team_id Int?
  player_id       Int?
  result          String? @db.VarChar(10)
  outs_after      Int?
  runs_scored     Int     @default(0)
  event_order     Int?

  game         GameSchedule? @relation(fields: [game_id], references: [id])
  batting_team Team?         @relation("BattingTeam", fields: [batting_team_id], references: [id])
  player       Player?       @relation("PlayerEvent", fields: [player_id], references: [id])

  @@index([game_id])
  @@index([player_id])
  @@map("game_events")
}

model TeamLineup {
  id            Int     @id @default(autoincrement())
  team_id       Int
  player_id     Int
  batting_order Int?
  is_pitcher    Boolean @default(false)
  rotation_slot Int?

  team   Team   @relation(fields: [team_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])

  @@index([team_id])
  @@map("team_lineup")
}

model FreeAgentAuction {
  id              Int      @id @default(autoincrement())
  player_id       Int
  season_id       Int
  status          String   @default("active") @db.VarChar(20)
  start_day       Int
  last_bid_day    Int?
  closes_on_day   Int?
  winning_team_id Int?
  created_at      DateTime @default(now())

  player       Player       @relation(fields: [player_id], references: [id])
  season       Season       @relation(fields: [season_id], references: [id])
  winning_team Team?        @relation("AuctionWinner", fields: [winning_team_id], references: [id])
  bids         AuctionBid[]

  @@index([status])
  @@index([closes_on_day])
  @@map("free_agent_auctions")
}

model AuctionBid {
  id         Int      @id @default(autoincrement())
  auction_id Int
  team_id    Int
  amount     Decimal  @db.Decimal(14, 2)
  years      Int      @default(1)
  season_day Int
  created_at DateTime @default(now())

  auction FreeAgentAuction @relation(fields: [auction_id], references: [id])
  team    Team             @relation(fields: [team_id], references: [id])

  @@index([auction_id])
  @@map("auction_bids")
}

model BroadcastCompany {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  type          String  @db.VarChar(5)
  price_per_fan Decimal @db.Decimal(6, 4)

  offers    BroadcastOffer[]
  contracts BroadcastContract[]

  @@map("broadcast_companies")
}

model BroadcastOffer {
  id            Int      @id @default(autoincrement())
  company_id    Int
  team_id       Int
  season_id     Int
  seasons       Int
  price_per_fan Decimal  @db.Decimal(6, 4)
  status        String   @db.VarChar(20)
  expires_day   Int
  created_at    DateTime @default(now())

  company BroadcastCompany @relation(fields: [company_id], references: [id])
  team    Team             @relation(fields: [team_id], references: [id])
  season  Season           @relation(fields: [season_id], references: [id])

  @@index([team_id])
  @@index([status])
  @@map("broadcast_offers")
}

model BroadcastContract {
  id                Int      @id @default(autoincrement())
  company_id        Int
  team_id           Int
  seasons_total     Int
  seasons_remaining Int
  price_per_fan     Decimal  @db.Decimal(6, 4)
  signed_season_id  Int
  created_at        DateTime @default(now())

  company BroadcastCompany @relation(fields: [company_id], references: [id])
  team    Team             @relation(fields: [team_id], references: [id])
  season  Season           @relation(fields: [signed_season_id], references: [id])

  @@index([team_id])
  @@map("broadcast_contracts")
}

model Coach {
  id                 Int    @id @default(autoincrement())
  team_id            Int
  name               String @db.VarChar(100)
  specialty          String @db.VarChar(20)
  skill_level        Int
  salary             Int
  assigned_player_id Int?   @unique

  team            Team    @relation(fields: [team_id], references: [id])
  assigned_player Player? @relation(fields: [assigned_player_id], references: [id])

  @@index([team_id])
  @@map("coaches")
}

model Draft {
  id           Int    @id @default(autoincrement())
  season_id    Int    @unique
  status       String @default("active") @db.VarChar(20)
  current_pick Int    @default(1)
  pick_order   Json

  season    Season          @relation(fields: [season_id], references: [id])
  prospects DraftProspect[]

  @@map("drafts")
}

model DraftProspect {
  id                    Int    @id @default(autoincrement())
  draft_id              Int
  name                  String @db.VarChar(100)
  position              String @db.VarChar(10)
  age                   Int
  current_skill         Int
  potential_coefficient Int
  growth_age            Int
  picked_by_team_id     Int?
  pick_number           Int?
  source_player_id      Int?

  draft         Draft   @relation(fields: [draft_id], references: [id])
  source_player Player? @relation(fields: [source_player_id], references: [id])

  @@index([draft_id])
  @@index([source_player_id])
  @@map("draft_prospects")
}

model Trade {
  id                Int      @id @default(autoincrement())
  season_id         Int
  proposer_team_id  Int
  recipient_team_id Int
  status            String   @default("pending") @db.VarChar(20) // pending | accepted | rejected | cancelled | expired
  cash_offered      Decimal  @default(0) @db.Decimal(14, 2) // proposer -> recipient
  cash_requested    Decimal  @default(0) @db.Decimal(14, 2) // recipient -> proposer
  created_day       Int
  expires_day       Int?
  resolved_day      Int?
  created_at        DateTime @default(now())

  season         Season      @relation(fields: [season_id], references: [id])
  proposer_team  Team        @relation("TradeProposer", fields: [proposer_team_id], references: [id])
  recipient_team Team        @relation("TradeRecipient", fields: [recipient_team_id], references: [id])
  items          TradeItem[]

  @@index([status])
  @@index([recipient_team_id])
  @@index([proposer_team_id])
  @@map("trades")
}

model TradeItem {
  id           Int @id @default(autoincrement())
  trade_id     Int
  player_id    Int
  from_team_id Int // equipo dueño del jugador al momento de proponer

  trade  Trade  @relation(fields: [trade_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])

  @@index([trade_id])
  @@index([player_id])
  @@map("trade_items")
}

model NewsItem {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(20)
  headline   String   @db.VarChar(500)
  season_day Int      @default(0)
  season_id  Int?
  team_id    Int?
  alert      Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([season_day])
  @@index([season_id])
  @@index([team_id])
  @@map("news_items")
}

model HomeRunDerbyEvent {
  id              Int      @id @default(autoincrement())
  season_id       Int
  day             Int
  status          String   @default("pending") @db.VarChar(20) // pending | completed
  winner_entry_id Int?     @unique
  created_at      DateTime @default(now())

  season  Season       @relation(fields: [season_id], references: [id])
  entries DerbyEntry[]
  swings  DerbySwing[]

  @@index([season_id])
  @@map("home_run_derby_events")
}

model DerbyEntry {
  id            Int     @id @default(autoincrement())
  event_id      Int
  team_id       Int
  player_id     Int
  reward_amount Decimal @db.Decimal(12, 2)
  home_runs     Int     @default(0)

  event  HomeRunDerbyEvent @relation(fields: [event_id], references: [id])
  team   Team              @relation(fields: [team_id], references: [id])
  player Player            @relation(fields: [player_id], references: [id])
  swings DerbySwing[]

  @@index([event_id])
  @@map("derby_entries")
}

model DerbySwing {
  id          Int     @id @default(autoincrement())
  event_id    Int
  entry_id    Int
  turn_number Int
  is_home_run Boolean

  event HomeRunDerbyEvent @relation(fields: [event_id], references: [id])
  entry DerbyEntry        @relation(fields: [entry_id], references: [id])

  @@index([entry_id])
  @@map("derby_swings")
}

model SeasonAward {
  id         Int      @id @default(autoincrement())
  season_id  Int
  category   String   @db.VarChar(30) // MVP | CY_YOUNG | ROOKIE_OF_YEAR | SEASON_HR_RECORD | SEASON_ERA_RECORD | SEASON_WIN_STREAK_RECORD
  player_id  Int? // null para logros de equipo (p.ej. SEASON_WIN_STREAK_RECORD)
  team_id    Int?
  value      Float
  created_at DateTime @default(now())

  season Season  @relation(fields: [season_id], references: [id])
  player Player? @relation(fields: [player_id], references: [id])
  team   Team?   @relation(fields: [team_id], references: [id])

  @@index([season_id])
  @@map("season_awards")
}

// Resumen congelado de bateo/pitcheo de un jugador para una temporada+equipo ya
// finalizada. Se crea una vez al terminar la temporada (ver seasonArchiveService.js),
// junto con el borrado de los game_events/game_lineups de esa temporada: mantiene
// el historico de carrera consultable sin acumular indefinidamente filas de juego a
// juego. Una temporada con traspaso de por medio genera una fila por (season, team).
model PlayerSeasonRecord {
  id        Int  @id @default(autoincrement())
  season_id Int
  year      Int
  team_id   Int?
  player_id Int
  first_day Int // dia minimo del stint, para desempatar orden dentro de la misma temporada (traspasos)

  // bateo
  games      Int @default(0)
  at_bats    Int @default(0)
  hits       Int @default(0)
  home_runs  Int @default(0)
  walks      Int @default(0)
  strikeouts Int @default(0)
  rbi        Int @default(0)

  // pitcheo (pitching_games = 0 significa que no lanzo en este stint)
  pitching_games      Int @default(0)
  pitching_outs       Int @default(0)
  earned_runs         Int @default(0)
  pitching_strikeouts Int @default(0)
  pitching_walks      Int @default(0)
  hits_allowed        Int @default(0)
  wins                Int @default(0)
  losses              Int @default(0)

  season Season @relation(fields: [season_id], references: [id])
  team   Team?  @relation(fields: [team_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])

  @@unique([season_id, team_id, player_id])
  @@index([player_id])
  @@index([season_id])
  @@map("player_season_records")
}

// Programa de Toddlers: cada fila es un ciclo de 10 temporadas. Se crea un pool de
// 32 futuros jugadores (Player.status = 'toddler_program', edad 8, skill -15) que
// los equipos mejoran aportando dinero. Al cumplir 10 temporadas el ciclo pasa a
// 'selecting': cada equipo elige 2 toddlers en orden del total aportado, y arranca
// automaticamente el siguiente ciclo. Ver services/toddlerProgramService.js.
model ToddlerProgram {
  id              Int      @id @default(autoincrement())
  cycle_number    Int      @default(1)
  seasons_elapsed Int      @default(0) // 0..10, +1 en cada fin de temporada
  budget          Decimal  @default(0) @db.Decimal(14, 2)
  status          String   @default("active") @db.VarChar(20) // active | selecting | completed
  pick_order      Json? // [teamId, teamId, ...] largo 32 (cada equipo dos veces, consecutivo), congelado al madurar
  current_pick    Int      @default(1) // 1..32 durante 'selecting'
  created_at      DateTime @default(now())

  contributions ToddlerContribution[]

  @@map("toddler_programs")
}

// Aporte acumulado de un equipo a un ciclo del programa. Define el orden de eleccion.
model ToddlerContribution {
  id         Int     @id @default(autoincrement())
  program_id Int
  team_id    Int
  amount     Decimal @default(0) @db.Decimal(14, 2)

  program ToddlerProgram @relation(fields: [program_id], references: [id])
  team    Team           @relation(fields: [team_id], references: [id])

  @@unique([program_id, team_id])
  @@index([program_id])
  @@map("toddler_contributions")
}
