{
  "name": "baseball-manager-desktop",
  "productName": "Baseball Manager",
  "version": "1.0.1",
  "private": true,
  "description": "Baseball Manager - versión de escritorio (Electron + SQLite)",
  "main": "main.js",
  "scripts": {
    "prepare-db": "node scripts/gen-schema.js && prisma generate --schema=prisma/schema.prisma && node scripts/check-migrations.js",
    "migration:new": "node scripts/migration-new.js",
    "icon": "icon-gen -i ../frontend/public/logo.svg -o build --ico --ico-name icon --ico-sizes 16,24,32,48,64,128,256 -r",
    "stage": "node scripts/stage.js",
    "build": "npm run prepare-db && npm run stage",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "icon-gen": "^5.0.0",
    "prisma": "6.19.3"
  },
  "build": {
    "appId": "com.baseballmanager.desktop",
    "productName": "Baseball Manager",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "migrator.js",
      "app/**/*",
      "prisma-client/**/*",
      "migrations/**/migration.sql",
      "build/icon.ico",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Baseball Manager"
    }
  }
}
